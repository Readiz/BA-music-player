http://music.readiz.com {
	redir https://music.readiz.com{uri} 308
}

music.readiz.com {
	import /Users/readiz/.local/share/readiz-auth/current/ops/caddy/sso-routes.Caddyfile
	root * /opt/homebrew/var/www/readiz-music/current
	encode zstd gzip
	header {
		?Cache-Control "no-cache"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		?Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://git.readiz.com; media-src 'self' blob: https://git.readiz.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
	@audio path /music/*
	handle @audio {
		route {
			header {
				Access-Control-Allow-Origin "*"
				Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
				Access-Control-Allow-Headers "Range, If-Range"
				Access-Control-Expose-Headers "Accept-Ranges, Content-Length, Content-Range, ETag"
				Cache-Control "no-cache"
			}
			@audio_preflight method OPTIONS
			respond @audio_preflight "" 204
			@audio_write not method GET HEAD
			respond @audio_write "" 405
			request_header -X-Readiz-Music-Object
			forward_auth 127.0.0.1:4525 {
				uri /_internal/music-static
				copy_headers X-Readiz-Music-Object
				transport http {
					response_header_timeout 5s
				}
			}
			rewrite * /{http.request.header.X-Readiz-Music-Object}
			root * /Users/readiz/.local/share/readiz-static/serve/objects
			file_server
		}
	}
	@library path /musicList.json /waveforms.json /imported-tracks.json /blue-archive-ost.json /lastUpdated.txt /library-info.json
	handle @library {
		root * /Users/readiz/.local/share/readiz-music/library/current
		header {
			Access-Control-Allow-Origin "*"
			Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
			Access-Control-Allow-Headers "Range, If-Range"
			Access-Control-Expose-Headers "Accept-Ranges, Content-Length, Content-Range, ETag"
			Cache-Control "no-cache"
		}
		@preflight method OPTIONS
		respond @preflight "" 204
		file_server
	}
	@covers path /assets/albums/*
	header @covers Access-Control-Allow-Origin "*"
	@music_api path /api/*
	handle @music_api {
		# Preserve the API's private/no-store authentication headers.
		reverse_proxy 127.0.0.1:4525
	}
	handle {
		file_server
	}
}

{
  "name": "BA-music-player",
  "version": "1.5.8",
  "description": "Readiz Music independent web player and Android app foundation",
  "main": "index.js",
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "dev": "node node_modules/serve/build/main.js dist -l tcp://127.0.0.1:4523",
    "devwin": "node node_modules/serve/build/main.js dist",
    "build": "node scripts/build.mjs",
    "deploy:local": "npm run build && node scripts/deploy-api.mjs && node scripts/deploy-static.mjs && node scripts/deploy-local.mjs",
    "build:apk:debug": "bash scripts/build-android.sh",
    "build:wgt": "python3 scripts/build-wgt.py",
    "start:api": "node server/start.mjs",
    "deploy:api": "node scripts/deploy-api.mjs",
    "build:apk": "bash scripts/build-android.sh release",
    "import:touhou": "node scripts/import-touhou.mjs",
    "import:touhou-original": "node scripts/import-touhou.mjs original",
    "library:publish": "node scripts/library.mjs publish",
    "library:stage-static": "node scripts/library.mjs stage-static",
    "static:mount": "node scripts/mount-static.mjs",
    "library:verify": "node scripts/library.mjs verify",
    "library:restore": "node scripts/library.mjs restore"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Readiz/BA-music-player.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Readiz/BA-music-player/issues"
  },
  "homepage": "https://github.com/Readiz/BA-music-player#readme",
  "dependencies": {
    "fs-extra": "^11.1.1",
    "glob": "^8.1.0",
    "glob-promise": "^6.0.2",
    "wavesurfer.js": "^7.8.1"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "serve": "^14.2.0"
  }
}
